# --- Web app (Next.js) ---
# SQLite database path. On Railway with a volume mounted at /data:
DATABASE_URL=file:/data/prod.db

# Public URL of the whatsapp-service (baked in at build time!).
# Example: https://fc-whatsapp-production.up.railway.app
NEXT_PUBLIC_WHATSAPP_URL=http://localhost:3003

# --- whatsapp-service (mini-services/whatsapp-service) ---
# PORT is injected by the platform (Railway). Defaults to 3003.
# AUTH_DIR: Baileys session storage. Put it on a persistent volume!
# AUTH_DIR=/data/auth-info-baileys
